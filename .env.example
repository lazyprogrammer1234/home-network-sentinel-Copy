# Home Network Sentinel – environment variable template
# Copy to .env and fill in your values.  Never commit the real .env to git.
#
# Optional: Discord webhook URL for alert notifications.
# Leave unset (or remove the line) to use terminal-only alerts.
# How to create a webhook: Discord server → Edit Channel → Integrations → Webhooks
#
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
